# York 環境變數配置範本
# 請複製此檔案為 .env 並填入實際值

# 本機專案資料夾路徑 (必填)
PROJECTS_DIR=/Users/yourname/Documents/git


# 知識庫儲存路徑 (必填) - 本地 Docker 掛載用
YORK_KNOWLEDGE_ROOT=./york-knowledge

# 遠端備份路徑 (選填) - 用於自動備份到 Google Drive
REMOTE_KNOWLEDGE_ROOT=G:\我的雲端硬碟\knowledge

# 允許存取的專案列表 (選填，逗號分隔，留空則允許所有)
ALLOWED_PROJECTS=

# 日誌等級 (選填，預設: info)
# 可選值: debug, info, warn, error
LOG_LEVEL=info

# 執行環境 (選填，預設: development)
# 可選值: development, production
NODE_ENV=development
