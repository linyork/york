# York 環境變數配置範本
# 請複製此檔案為 .env 並填入實際值

# 本機專案資料夾路徑 (必填)
PROJECTS_DIR=/Users/yourname/Documents/git

# 知識庫與向量資料庫儲存路徑 (選填，預設: ./data)
# YORK_KNOWLEDGE_ROOT=

# 允許存取的專案列表 (選填，逗號分隔，留空則允許所有)
ALLOWED_PROJECTS=

# 日誌等級 (選填，預設: info)
# 可選值: debug, info, warn, error
LOG_LEVEL=info

# 執行環境 (選填，預設: development)
# 可選值: development, production
NODE_ENV=development
