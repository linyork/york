# ==========================================
# Python 相關
# ==========================================
# Python-generated files
__pycache__/
*.py[oc]
*.pyo
*.pyd
build/
dist/
wheels/
*.egg-info
*.egg

# Virtual environments
.venv
venv/
ENV/
env/

